# Copy to ~/.claude-telegram.env and fill in.

# From @BotFather -- one bot per beam, see README.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (not username). Get it from @userinfobot.
# Only /start from this id will be accepted.
TELEGRAM_OWNER_ID=

# Optional overrides -- defaults shown.
# CLAUDE_MODEL=opus
# CLAUDE_FALLBACK_MODEL=sonnet
# CLAUDE_EFFORT=high
# WORK_DIR=/home/beams/work
